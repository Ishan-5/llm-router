# Copy to .env.local (or Vercel env vars) and fill in.
# NEVER commit real keys. gitignore already excludes .env / .env.local.

# Backend base URL (Render in prod, http://127.0.0.1:8000 locally)
VITE_API_BASE=https://llm-router-d2b2.onrender.com

# Supabase project URL + publishable/anon key (Settings -> API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Admin user UUID (only if you manage the admin dashboard)
VITE_ADMIN_USER_ID=<user-uuid>

# Optional: routewise API key for authenticated calls (dev only)
#VITE_API_KEY=rw_xxx