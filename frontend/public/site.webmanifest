{
  "name": "Routewise — Cost-Aware LLM Request Router",
  "short_name": "Routewise",
  "description": "Cost-aware LLM router. Scores query difficulty, routes to the cheapest model tier, caches near-duplicates. Saves 40%+ vs always using frontier models.",
