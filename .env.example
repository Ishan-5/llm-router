# === Required ===
DATABASE_URL=postgresql://...
GEMINI_API_KEY=...
TAVILY_API_KEY=...
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# === Admin ===
# Supabase user UUID that gets admin access (global stats, all keys, all logs)
ADMIN_USER_ID=your-supabase-user-uuid

# === Single Groq key (fallback if multi-key not set) ===
GROQ_API_KEY=gsk_...

# === Multi-key load balancing (comma-separated, 1-3 keys per tier) ===
# If set, these override GROQ_API_KEY for the default routing path.
# Keys rotate round-robin. Rate-limited keys skip for 30s.
GROQ_KEYS_CHEAP=gsk_key1,gsk_key2,gsk_key3
GROQ_KEYS_MID=gsk_key4,gsk_key5,gsk_key6
GROQ_KEYS_FRONTIER=gsk_key7,gsk_key8,gsk_key9
